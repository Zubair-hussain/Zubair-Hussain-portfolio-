# ============================================================================
#  Environment variables — copy this file to `.env.local` and fill in values.
#  `.env.local` is git-ignored. Restart `npm run dev` after editing.
# ============================================================================

NEXT_PUBLIC_SITE_URL=https://zubairdeveloper.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Google Search Console verification (only emitted when set).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Blogger (optional official API; the public JSON feed is the fallback) ---
# The public blog ID is fixed in src/lib/blog.ts. Keep this API key server-side.
# Never prefix it with NEXT_PUBLIC_.
BLOGGER_API_KEY=

# --- Firebase (powers the Testimonials section) -----------------------------
# Get these from Firebase Console → Project settings → General → Your apps.
# The app runs fine WITHOUT these — Testimonials live features just stay off.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Email allowed to access the Testimonials admin panel.
NEXT_PUBLIC_ADMIN_EMAIL=thezubairh@gmail.com

# --- Optional: EmailJS (contact form) ---------------------------------------
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# NOTE: The Firebase web API key above is NOT a secret — it only identifies
# your project and is safe to ship to the browser. Your data is protected by
# firestore.rules + Firebase Auth, NOT by hiding this key.

# NOTE: Zubair AI (chatbot) and the timeline suggestion both run on Cloudflare
# Workers AI server-side — NO API key is shipped to the browser. (The old
# NEXT_PUBLIC_HF_API_KEY was removed because it leaked into the client bundle.)

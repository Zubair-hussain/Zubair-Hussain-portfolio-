{
  "name": "zubair-hussain-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.5.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "blog:generate": "node scripts/generate-blog-data.mjs",
    "docs:readme": "node scripts/generate-readme-handbook.mjs",
    "docs:animation": "node scripts/generate-avatar-gif.mjs",
    "predev": "npm run blog:generate",
    "dev": "next dev",
    "prebuild": "npm run blog:generate",
    "build": "next build --webpack",
    "preview": "npm run blog:generate && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run blog:generate && opennextjs-cloudflare build && opennextjs-cloudflare deploy --keep-vars",
    "cf-build": "npm run blog:generate && opennextjs-cloudflare build",
    "cf-deploy": "opennextjs-cloudflare deploy --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run test/articles-api.test.ts test/blog-deduplication.test.ts test/blog-normalization.test.ts test/contact-route.test.ts test/email-verification.test.ts test/firebase-config.test.ts test/profile-links.test.ts test/schedule-route.test.ts test/schedule-security.test.ts test/site-url.test.ts test/utils.test.ts --coverage --logHeapUsage --maxWorkers=2 --environment=node",
    "records:generate": "node .github/scripts/generate-records.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@huggingface/inference": "^4.13.30",
    "@marsidev/react-turnstile": "^1.4.2",
    "@opennextjs/cloudflare": "^1.20.6",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@react-spring/three": "^9.7.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^2.16.2",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^11.3.19",
    "lenis": "^1.1.9",
    "lucide-react": "^0.414.0",
    "next": "^16.3.6",
    "next-intl": "^4.14.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "tailwind-merge": "^2.5.2",
    "three": "^0.183.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.168.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.0",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.77.0"
  }
}
